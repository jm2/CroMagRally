+class PathField:
+    """Drivable path length from every PATH_STEP cell of a playfield to the nearest of some
+    sources (Dijkstra over 8-neighbour moves; see CTF_PATH_TOL). Deterministic: IEEE sums of the
+    two move lengths, ties broken by cell index."""
+
+    def __init__(self, md, sources):
+        pf = md.pf
+        su = terlib.SUPERTILE_UNITS
+        used = [(r, c) for r, row in enumerate(pf.stGrid) for c, v in enumerate(row) if v > 0]
+        self.x0 = min(c for _, c in used) * su
+        self.z0 = min(r for r, _ in used) * su
+        self.nx = int(((max(c for _, c in used) + 1) * su - self.x0) // PATH_STEP)
+        nz = int(((max(r for r, _ in used) + 1) * su - self.z0) // PATH_STEP)
+        nx = self.nx
+        xs = [self.x0 + (c + 0.5) * PATH_STEP for c in range(nx)]
+        zs = [self.z0 + (r + 0.5) * PATH_STEP for r in range(nz)]
+        height = [pf.terrain_y(x, z) for z in zs for x in xs]
+        ok = [pf.supertile_id(x, z) > 0 for z in zs for x in xs]
+        fences = {}                                 # cell -> fence sections near it
+        for k, (_, _, sx0, sx1, sz0, sz1) in enumerate(md.fence_segs):
+            for c in range(max(0, int((sx0 - self.x0) // PATH_STEP) - 1), min(nx, int((sx1 - self.x0) // PATH_STEP) + 2)):
+                for r in range(max(0, int((sz0 - self.z0) // PATH_STEP) - 1), min(nz, int((sz1 - self.z0) // PATH_STEP) + 2)):
+                    fences.setdefault(r * nx + c, []).append(k)
+        moves = [(dr, dc, PATH_STEP * math.sqrt(dr * dr + dc * dc)) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]
+        dist_ = self.dist = [math.inf] * (nx * nz)
+        heap = []
+        for sx, sz in sources:
+            i = self.cell(sx, sz)
+            if i is not None and dist_[i] > 0:
+                dist_[i] = 0.0
+                heap.append((0.0, i))
+        heapq.heapify(heap)
+        segs = md.fence_segs
+        while heap:                                 # from the sources outwards: a step i -> j
+            d, i = heapq.heappop(heap)              # is a car driving from j to i
+            if d > dist_[i]:
+                continue
+            r, c = divmod(i, nx)
+            for dr, dc, step in moves:
+                rr, cc = r + dr, c + dc
+                if not (0 <= rr < nz and 0 <= cc < nx):
+                    continue
+                j = rr * nx + cc
+                if not ok[j] or d + step >= dist_[j] or (height[i] - height[j]) / step > PATH_MAX_CLIMB:
+                    continue
+                near = fences.get(i, []) + fences.get(j, [])
+                if near and any(terlib.seg_intersect((xs[c], zs[r]), (xs[cc], zs[rr]), segs[k][0], segs[k][1]) for k in near):
+                    continue
+                dist_[j] = d + step
+                heapq.heappush(heap, (d + step, j))
+
+    def cell(self, x, z):
+        c, r = int((x - self.x0) // PATH_STEP), int((z - self.z0) // PATH_STEP)
+        if 0 <= c < self.nx and 0 <= r < len(self.dist) // self.nx:
+            return r * self.nx + c
+        return None
+
+    def at(self, x, z):
+        """Path length from (x, z)'s cell, or None if no drivable path leads to a source."""
+        i = self.cell(x, z)
+        d = self.dist[i] if i is not None else math.inf
+        return None if d == math.inf else d
